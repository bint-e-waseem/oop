//A library wants to maintain information about its books using an object-oriented approach.&#x20;

//Develop a C++ class named **Book** that stores the **title**, **author name**, and **price** of a book as private data members
//. Implement both the **default constructor** and the **copy constructor** for the class. Also, create getter, setter for private data-members
//and a member function named **displayBookDetails()** that displays all book information in a readable format.

//In the **main()** function, dynamically allocate memory for a Book object using a pointer, allow
//the user to enter the book details through the pointer, and display the stored information using
//the same pointer. Additionally, create a second Book object using the **copy constructor** and display its details to verify that the
//copying process has been performed correctly.
//Finally, release the dynamically allocated memory before program termination.*/


#include <iostream>
#include <string>
using namespace std;

class Book {
private:
    string title;
    string authorName;
    float price;

public:
    
    Book() {
        title = "Not Set";
        authorName = "Not Set";
        price = 0.0;
    }

    
    Book(const Book &b) {
        title = b.title;
        authorName = b.authorName;
        price = b.price;
    }

   
    void setTitle(string t) {
        title = t;
    }

    void setAuthorName(string a) {
        authorName = a;
    }

    void setPrice(float p) {
        price = p;
    }

    
    string getTitle() {
        return title;
    }

    string getAuthorName() {
        return authorName;
    }

    float getPrice() {
        return price;
    }

    
    void displayBookDetails() {
        cout << "\n--- Book Details ---" << endl;
        cout << "Title: " << title << endl;
        cout << "Author Name: " << authorName << endl;
        cout << "Price: " << price << endl;
    }
};

int main() {

    
    Book *ptr = new Book();

    string title, author;
    float price;

    
    cout << "Enter Book Title: ";
    getline(cin, title);

    cout << "Enter Author Name: ";
    getline(cin, author);

    cout << "Enter Book Price: ";
    cin >> price;

    
    ptr->setTitle(title);
    ptr->setAuthorName(author);
    ptr->setPrice(price);

    
    cout << "\nOriginal Book:";
    ptr->displayBookDetails();

    
    Book book2(*ptr);

    
    cout << "\nCopied Book:";
    book2.displayBookDetails();

    
    delete ptr;
    ptr = nullptr;

    return 0;
}
