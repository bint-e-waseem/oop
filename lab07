#include <iostream>
#include <iomanip>
using namespace std;

class Circle
{
private:
    double radius;
    const double pi = 3.14159;

public:
    
    Circle()
    {
        radius = 0.0;
    }

  
    Circle(double r)
    {
        radius = r;
    }

    void setRadius(double r)
    {
        radius = r;
    }

    double getRadius() const
    {
        return radius;
    }

   
    double getArea() const
    {
        return pi * radius * radius;
    }

    
    double getDiameter() const
    {
        return 2 * radius;
    }

    // Calculate Circumference
    double getCircumference() const
    {
        return 2 * pi * radius;
    }
};

int main()
{
    int n;

    cout << "Enter the number of circles: ";
    cin >> n;

    
    Circle circles[n];

    
    for(int i = 0; i < n; i++)
    {
        double r;
        cout << "\nEnter radius of Circle " << i + 1 << ": ";
        cin >> r;

        circles[i].setRadius(r);
    }

    cout << fixed << setprecision(2);

    cout << "\n----- Circle Details -----\n";

    for(int i = 0; i < n; i++)
    {
        cout << "\nCircle " << i + 1 << endl;
        cout << "Radius        : " << circles[i].getRadius() << endl;
        cout << "Area          : " << circles[i].getArea() << endl;
        cout << "Diameter      : " << circles[i].getDiameter() << endl;
        cout << "Circumference : "
             << circles[i].getCircumference() << endl;
    }


    return 0;
}
